// prisma/schema.prisma
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  priceUSD        Int?
  features        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  active          Boolean   @default(true)
  audience        Audience  @default(INDIVIDUAL)
  durationMin     Int?
  image           String?
  isPopular       Boolean   @default(false)
  priceType       PriceType @default(BUNDLE)
  sessionsPerPack Int?
  sortOrder       Int       @default(0)
  startingAtUSD   Int?
  userPackages UserPackage[]
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String?
  hashedPassword        String
  role                  String                 @default("learner")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  timezone              String?
  isDisabled            Boolean                @default(false)
  rateHourlyCents       Int?
  ratePerSessionCents   Int?
  assessmentSubmissions AssessmentSubmission[]
  audits                Audit[]                @relation("Audit_actor")
  onboardingForms       OnboardingForm[]
  teachingSessions      Session[]              @relation("SessionTeacher")

  // Legacy 1:1 learner ownership (Session.userId)
  sessions              Session[]

  // New: membership rows for group sessions (and future-proof for 1:1 as well)
  sessionParticipants   SessionParticipant[]

  sessionFeedbacks      SessionFeedback[]
  userPackages          UserPackage[]

  // In-app notifications
  notifications         Notification[]

  @@index([role])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // e.g. booking_confirmed, reminder_24h, payment_receipt
  type      String

  title     String
  body      String?
  data      Json?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Audit {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  entity    String
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User     @relation("Audit_actor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model Session {
  id                              Int              @id @default(autoincrement())
  title                           String
  startAt                         DateTime
  endAt                           DateTime?
  notes                           String?

  // New: session kind + group capacity
  type                            SessionType       @default(ONE_ON_ONE)
  capacity                        Int?

  // Legacy 1:1 learner owner (kept for compatibility + migration)
  // For GROUP sessions, this can be null.
  userId                          Int?
  user                            User?             @relation(fields: [userId], references: [id])

  teacherId                       Int?
  teacher                         User?             @relation("SessionTeacher", fields: [teacherId], references: [id])

  // New: participant membership (many learners per session)
  participants                    SessionParticipant[]

  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  reminder24hSentAt               DateTime?
  reminder6hSentAt                DateTime?
  reminder1hSentAt                DateTime?
  feedbackScore                   Int?
  status                          SessionStatus     @default(scheduled)
  joinUrl                         String?
  teacherFeedbackComments         String?
  teacherFeedbackFutureSteps      String?
  teacherFeedbackMessageToLearner String?
  classroomState                  Json?

  feedback                        SessionFeedback?

  @@index([userId, startAt])
  @@index([teacherId, startAt])
  @@index([type, startAt])
}

model SessionParticipant {
  id        Int      @id @default(autoincrement())

  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    String   @default("booked")
  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}


model SessionFeedback {
  id                String   @id @default(cuid())
  sessionId         Int      @unique
  createdAt         DateTime @default(now())
  commentsOnSession String?
  futureSteps       String?
  messageToLearner  String?
  teacherId         Int
  updatedAt         DateTime @updatedAt
  session           Session  @relation(fields: [sessionId], references: [id])
  teacher           User     @relation(fields: [teacherId], references: [id])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id
  amountCents   Int
  currency      String   @default("EGP")
  status        String   @default("pending")
  psp           String   @default("paymob")
  pspOrderId    Int?
  customerEmail String?
  customerPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        Int?
  packageId     Int?
  paymobTxnId   Int?

  userPackage   UserPackage?  // ✅ add this line (back relation)

  @@index([userId])
  @@index([packageId])
}

model UserPackage {
  id                Int       @id @default(autoincrement())
  userId            Int
  packageId         Int

  // ✅ NEW: ties the entitlement to a specific Order.id (merchant_order_id)
  orderId           String?   @unique
  order             Order?    @relation(fields: [orderId], references: [id])

  title             String
  minutesPerSession Int?
  sessionsTotal     Int
  sessionsUsed      Int       @default(0)
  expiresAt         DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  user              User      @relation(fields: [userId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])

  @@index([userId, status])
}

model OnboardingForm {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  answers   Json
  status    String   @default("submitted")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AssessmentSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  text      String
  wordCount Int
  status    String   @default("submitted")
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum Audience {
  INDIVIDUAL
  CORPORATE
}

enum PriceType {
  PER_SESSION
  BUNDLE
  CUSTOM
}

enum SessionType {
  ONE_ON_ONE
  GROUP
}

enum SessionStatus {
  scheduled
  completed
  canceled
}
