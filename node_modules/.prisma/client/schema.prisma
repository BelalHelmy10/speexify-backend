// prisma/schema.prisma
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  lessonType       SessionType?
  catalogKey       String?       @unique
  pricingOverrides Json?
  id               Int           @id @default(autoincrement())
  title            String
  description      String?
  priceUSD         Int?
  features         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  active           Boolean       @default(true)
  audience         Audience      @default(INDIVIDUAL)
  durationMin      Int?
  image            String?
  isPopular        Boolean       @default(false)
  priceType        PriceType     @default(BUNDLE)
  sessionsPerPack  Int?
  sortOrder        Int           @default(0)
  startingAtUSD    Int?
  userPackages     UserPackage[]
  orders           Order[]
  deletedAt        DateTime?
}

model User {
  id                        Int                    @id @default(autoincrement())
  email                     String                 @unique
  name                      String?
  avatarUrl                 String?
  hashedPassword            String
  role                      String                 @default("learner")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  timezone                  String?
  language                  String?                @default("en")
  notificationPreferences   Json?
  calendarFeedRevokedAt     DateTime?
  passwordChangedAt         DateTime?
  isDisabled                Boolean                @default(false)
  // Legacy field names retained for API compatibility. Their historical
  // currency is not trusted by the earnings ledger.
  rateHourlyCents           Int?
  ratePerSessionCents       Int?
  // Canonical teacher compensation fields. Values are EGP piastres.
  rateHourlyEgpPiastres     Int?
  ratePerSessionEgpPiastres Int?
  assessmentSubmissions     AssessmentSubmission[]
  reviewedAssessments       AssessmentSubmission[] @relation("AssessmentReviewReviewer")
  audits                    Audit[]                @relation("Audit_actor")
  onboardingForms           OnboardingForm[]
  teachingSessions          Session[]              @relation("SessionTeacher")

  // Legacy 1:1 learner ownership (Session.userId)
  sessions Session[]

  // New: membership rows for group sessions (and future-proof for 1:1 as well)
  sessionParticipants SessionParticipant[]

  sessionFeedbacks SessionFeedback[]
  userPackages     UserPackage[]
  orders           Order[]

  // In-app notifications
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  calendarFeedTokens     CalendarFeedToken[]

  // Support tickets + messages
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  classroomMessages    ClassroomMessage[]
  classroomAnnotations ClassroomAnnotation[]

  // ✨ Support ticket assignment (admin can assign tickets to staff)
  assignedSupportTickets SupportTicket[] @relation("AssignedSupportTickets")

  // ✨ Internal notes authored by staff
  supportInternalNotes SupportInternalNote[] @relation("SupportNoteAuthor")

  // Learner feedback on sessions
  learnerFeedbacks LearnerSessionFeedback[] @relation("LearnerFeedbacks")

  // ✨ NEW: User availability for scheduling
  availabilities                   Availability[]
  teacherEarnings                  TeacherEarning[]            @relation("TeacherEarningTeacher")
  teacherRateHistory               TeacherRateHistory[]        @relation("TeacherRateHistoryTeacher")
  createdTeacherRateHistory        TeacherRateHistory[]        @relation("TeacherRateHistoryCreator")
  teacherEarningSnapshotJobs       TeacherEarningSnapshotJob[] @relation("TeacherEarningSnapshotJobTeacher")
  teacherPayouts                   TeacherPayout[]             @relation("TeacherPayoutTeacher")
  teacherEarningAdjustments        TeacherEarningAdjustment[]  @relation("TeacherEarningAdjustmentTeacher")
  createdTeacherEarningAdjustments TeacherEarningAdjustment[]  @relation("TeacherEarningAdjustmentCreator")
  createdTeacherPayouts            TeacherPayout[]             @relation("TeacherPayoutCreator")
  deletedAt                        DateTime?

  @@index([role])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ✨ NEW: Availability - Users can set their available time slots
// ─────────────────────────────────────────────────────────────────────────────

model Availability {
  id Int @id @default(autoincrement())

  // The user who owns this availability slot
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Day of week (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
  // If null, this is a specific date slot rather than recurring
  dayOfWeek Int?

  // For specific date availability (non-recurring)
  specificDate DateTime?

  // Time range (stored as "HH:MM" in 24h format)
  startTime String // e.g., "09:00"
  endTime   String // e.g., "17:00"

  // Timezone for this availability (user's timezone at creation)
  timezone String?

  // Whether this is a recurring weekly slot or one-time
  isRecurring Boolean @default(true)

  // Status: active, inactive (soft disable without deleting)
  status String @default("active")

  // Optional note/label for the slot
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dayOfWeek])
  @@index([userId, specificDate])
  @@index([status, dayOfWeek])
  @@index([userId, status, isRecurring, dayOfWeek, startTime], map: "Availability_user_status_recur_day_start_idx")
  @@index([userId, status, isRecurring, specificDate, startTime], map: "Availability_user_status_recur_date_start_idx")
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // e.g. booking_confirmed, reminder_24h, payment_receipt
  type String

  title      String
  body       String?
  data       Json?
  deliveries NotificationDelivery[]

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, readAt, id], map: "Notification_userId_readAt_id_idx")
}

// Durable email delivery records. The notification remains the user-facing
// in-app record; this table tracks provider delivery, retries, and admin
// visibility for asynchronous email delivery.
model NotificationDelivery {
  id             Int       @id @default(autoincrement())
  userId         Int?
  notificationId Int?
  channel        String    @default("EMAIL")
  eventType      String
  recipient      String
  subject        String
  bodyHtml       String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([notificationId])
}

// Opaque, database-backed calendar subscriptions. The raw token is only
// returned when a link is generated; only its SHA-256 hash is stored.
model CalendarFeedToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Support: in-app chat-style support, backed by tickets + thread messages
// ✨ ENHANCED with enterprise features
// ─────────────────────────────────────────────────────────────────────────────

enum SupportCategory {
  PAYMENT
  BOOKING
  CLASSROOM_TECH
  ACCOUNT
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ✨ Priority levels for ticket triage
enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id Int @id @default(autoincrement())

  // The user who opened the ticket
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category SupportCategory
  subject  String?
  status   SupportStatus   @default(OPEN)

  // ✨ Priority system (default NORMAL)
  priority SupportPriority @default(NORMAL)

  // ✨ Ticket assignment (which staff member is handling this)
  assignedToId Int?
  assignedTo   User? @relation("AssignedSupportTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Soft resolution timestamps
  resolvedAt DateTime?

  firstResponseAt     DateTime?
  lastCustomerReplyAt DateTime?
  lastStaffReplyAt    DateTime?
  slaDueAt            DateTime?
  closedAt            DateTime?
  reopenedAt          DateTime?
  reopenCount         Int       @default(0)
  satisfactionRating  Int?
  satisfactionComment String?
  tags                String[]  @default([])
  source              String    @default("widget")
  relatedSessionId    Int?
  relatedPaymentId    Int?
  assignedTeamId      Int?
  aiStatus            String    @default("off")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  // ✨ Internal notes (staff-only collaboration)
  internalNotes SupportInternalNote[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([category, updatedAt])
  @@index([priority, updatedAt])
  @@index([assignedToId, updatedAt])
  @@index([slaDueAt])
  @@index([lastCustomerReplyAt])
  @@index([userId, status, updatedAt], map: "SupportTicket_userId_status_updatedAt_idx")
  @@index([status, priority, updatedAt], map: "SupportTicket_status_priority_updatedAt_idx")
}

model SupportMessage {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Who authored the message
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  // Simple flag for staff replies (we can refine later)
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())

  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model SupportAttachment {
  id Int @id @default(autoincrement())

  messageId Int
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  mimeType String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([messageId])
}

// ✨ Internal notes for staff collaboration
model SupportInternalNote {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Staff member who wrote the note
  authorId Int
  author   User @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model Audit {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  entity    String
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User     @relation("Audit_actor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model Session {
  id      Int       @id @default(autoincrement())
  title   String
  startAt DateTime
  endAt   DateTime?
  notes   String?

  // New: session kind + group capacity
  type     SessionType @default(ONE_ON_ONE)
  capacity Int?

  // Legacy 1:1 learner owner (kept for compatibility + migration)
  // For GROUP sessions, this can be null.
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  teacherId Int?
  teacher   User? @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  // New: participant membership (many learners per session)
  participants         SessionParticipant[]
  classroomMessages    ClassroomMessage[]
  classroomAnnotations ClassroomAnnotation[]

  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  completedAt                     DateTime?
  reminder24hSentAt               DateTime?
  reminder6hSentAt                DateTime?
  reminder1hSentAt                DateTime?
  feedbackScore                   Int?
  status                          SessionStatus @default(scheduled)
  joinUrl                         String?
  teacherFeedbackComments         String?
  teacherFeedbackFutureSteps      String?
  teacherFeedbackMessageToLearner String?
  classroomState                  Json?

  feedback SessionFeedback?

  // ─── Classroom Experience Fields ───
  teacherNotes              String?
  resourcesUsed             Json?                      @default("[]")
  resourcesUsedAt           Json?                      @default("{}")
  learnerFeedbacks          LearnerSessionFeedback[]
  teacherEarning            TeacherEarning?
  teacherEarningSnapshotJob TeacherEarningSnapshotJob?

  @@index([userId, startAt])
  @@index([teacherId, startAt])
  @@index([type, startAt])
  @@index([status, startAt], map: "Session_status_startAt_idx")
  @@index([teacherId, status, startAt], map: "Session_teacherId_status_startAt_idx")
  @@index([userId, status, startAt], map: "Session_userId_status_startAt_idx")
}

// EGP teacher earnings are stored in piastres (the smallest EGP unit).
// Entries are immutable snapshots of the rate and duration used for the
// completed session. A payout only changes the settlement metadata.
model TeacherEarning {
  id                 Int       @id @default(autoincrement())
  teacherId          Int
  sessionId          Int       @unique
  amountMinor        Int
  // The SQL migration constrains this ledger to the canonical EGP currency.
  currencyCode       String    @default("EGP")
  rateType           String    @default("none")
  rateMinor          Int?
  rateSnapshotAt     DateTime  @default(now())
  rateEffectiveFrom  DateTime?
  rateSnapshotSource String    @default("completion_current_rate")
  durationMinutes    Int       @default(60)
  // The SQL migration constrains this field to PENDING or PAID.
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  paidAt             DateTime?
  payoutId           Int?

  // Keep historical earnings from disappearing if an account/session is removed.
  teacher User           @relation("TeacherEarningTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  session Session        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  payout  TeacherPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([teacherId, status, createdAt])
  @@index([payoutId])
}

// Effective-dated EGP compensation history. Earnings resolve a rate at the
// session completion timestamp and copy the result into their own immutable
// snapshot fields. A missing historical rate is intentionally not inferred.
model TeacherRateHistory {
  id                        Int       @id @default(autoincrement())
  teacherId                 Int
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  rateHourlyEgpPiastres     Int?
  ratePerSessionEgpPiastres Int?
  createdById               Int?
  createdAt                 DateTime  @default(now())

  teacher   User  @relation("TeacherRateHistoryTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy User? @relation("TeacherRateHistoryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([teacherId, effectiveFrom])
  @@index([teacherId, effectiveFrom])
}

// Transactional outbox for payroll snapshots. A completed session creates a
// PENDING row before the completion request can succeed; workers retry FAILED
// rows until the TeacherEarning snapshot is durable.
model TeacherEarningSnapshotJob {
  id            Int       @id @default(autoincrement())
  sessionId     Int       @unique
  teacherId     Int
  // The SQL migration constrains this field to the four worker states.
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  lastAttemptAt DateTime?
  succeededAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  teacher User    @relation("TeacherEarningSnapshotJobTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([teacherId, status])
}

model TeacherPayout {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  createdById      Int
  totalMinor       Int
  currencyCode     String   @default("EGP")
  // The SQL migration constrains this to bank_transfer, cash, wallet, other.
  paymentMethod    String
  paymentReference String?
  note             String?
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  teacher     User                       @relation("TeacherPayoutTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy   User                       @relation("TeacherPayoutCreator", fields: [createdById], references: [id], onDelete: Restrict)
  earnings    TeacherEarning[]
  adjustments TeacherEarningAdjustment[]

  @@index([teacherId, paidAt])
}

// Signed admin adjustments are append-only ledger entries. Positive values
// add to a teacher's pending balance; negative values correct it downward.
// They are never deleted so every balance change remains explainable.
model TeacherEarningAdjustment {
  id           Int       @id @default(autoincrement())
  teacherId    Int
  createdById  Int
  amountMinor  Int
  // The SQL migration constrains this ledger to the canonical EGP currency.
  currencyCode String    @default("EGP")
  reason       String
  // The SQL migration constrains this field to PENDING or PAID.
  status       String    @default("PENDING")
  paidAt       DateTime?
  payoutId     Int?
  createdAt    DateTime  @default(now())

  teacher   User           @relation("TeacherEarningAdjustmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy User           @relation("TeacherEarningAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payout    TeacherPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([teacherId, status, createdAt])
  @@index([payoutId])
}

model SessionParticipant {
  id Int @id @default(autoincrement())

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     String    @default("booked")
  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([userId, status], map: "SessionParticipant_userId_status_idx")
  @@index([sessionId, status], map: "SessionParticipant_sessionId_status_idx")
}

model ClassroomMessage {
  id String @id @default(cuid())

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  senderId Int?
  sender   User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  senderRole String
  senderName String?
  body       String

  deletedAt   DateTime?
  deletedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, createdAt])
  @@index([senderId, createdAt])
  @@index([deletedAt])
}

model ClassroomAnnotation {
  id         String   @id @default(cuid())
  sessionId  Int
  userId     Int
  resourceId String
  payload    Json
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, resourceId])
  @@index([sessionId, resourceId])
  @@index([userId, updatedAt])
}

model SessionFeedback {
  id                String   @id @default(cuid())
  sessionId         Int      @unique
  createdAt         DateTime @default(now())
  commentsOnSession String?
  futureSteps       String?
  messageToLearner  String?
  teacherId         Int
  updatedAt         DateTime @updatedAt
  session           Session  @relation(fields: [sessionId], references: [id])
  teacher           User     @relation(fields: [teacherId], references: [id])
}

// ─── Learner Session Feedback (post-session ratings/surveys) ───
model LearnerSessionFeedback {
  id        String @id @default(cuid())
  sessionId Int
  learnerId Int

  // Rating 1-5 stars
  rating Int

  // Optional feedback text fields
  highlights    String?
  improvements  String?
  otherFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner User    @relation("LearnerFeedbacks", fields: [learnerId], references: [id], onDelete: Cascade)

  // Each learner can only submit one feedback per session
  @@unique([sessionId, learnerId])
  @@index([sessionId])
  @@index([learnerId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  pricingSnapshot Json?
  id              String        @id
  amountCents     Int
  currency        String        @default("EGP")
  status          String        @default("pending")
  psp             String        @default("paymob")
  pspOrderId      Int?
  customerEmail   String?
  customerPhone   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  packageId       Int?
  package         Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymobTxnId     Int?
  discountCodeId  Int?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  userPackage UserPackage?

  @@index([userId])
  @@index([packageId])
  @@index([status, updatedAt], map: "Order_status_updatedAt_idx")
  @@index([paymobTxnId], map: "Order_paymobTxnId_idx")
  @@index([pspOrderId], map: "Order_pspOrderId_idx")
}

model DiscountCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  percentage Int // 50 = 50% off
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders Order[]
}

model UserPackage {
  lessonType SessionType?
  id         Int          @id @default(autoincrement())
  userId     Int
  packageId  Int

  creditDebits CreditDebit[]

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  title             String
  minutesPerSession Int?
  sessionsTotal     Int
  sessionsUsed      Int       @default(0)
  expiresAt         DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  user              User      @relation(fields: [userId], references: [id])
  package           Package   @relation(fields: [packageId], references: [id])

  @@index([userId, status])
  @@index([userId, status, expiresAt], map: "UserPackage_userId_status_expiresAt_idx")
  @@index([userId, status, createdAt], map: "UserPackage_userId_status_createdAt_idx")
}

model OnboardingForm {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  answers   Json
  status    String   @default("submitted")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AssessmentSubmission {
  id           Int       @id @default(autoincrement())
  userId       Int
  packageId    Int?
  text         String
  wordCount    Int
  status       String    @default("submitted")
  score        Int?
  cefr         String?
  feedback     String?
  reviewMeta   Json?
  reviewedAt   DateTime?
  reviewedById Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  reviewedBy   User?     @relation("AssessmentReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([reviewedById, reviewedAt])
}

enum Audience {
  INDIVIDUAL
  CORPORATE
}

enum PriceType {
  PER_SESSION
  BUNDLE
  CUSTOM
}

enum SessionType {
  ONE_ON_ONE
  GROUP
}

enum SessionStatus {
  scheduled
  completed
  canceled
}

// Each charge retains its source package and a single reversal timestamp.
// Session/user IDs are historical identifiers retained when accounts are anonymized.
model CreditDebit {
  id            Int         @id @default(autoincrement())
  sessionId     Int
  userId        Int
  userPackageId Int
  userPackage   UserPackage @relation(fields: [userPackageId], references: [id])
  createdAt     DateTime    @default(now())
  reversedAt    DateTime?

  // A partial unique index in SQL enforces one active debit per session/user
  // while allowing a new debit after the prior one has been reversed.
  @@index([sessionId, userId])
}
