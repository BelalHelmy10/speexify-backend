// prisma/schema.prisma
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id              Int           @id @default(autoincrement())
  title           String
  description     String?
  priceUSD        Int?
  features        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  active          Boolean       @default(true)
  audience        Audience      @default(INDIVIDUAL)
  durationMin     Int?
  image           String?
  isPopular       Boolean       @default(false)
  priceType       PriceType     @default(BUNDLE)
  sessionsPerPack Int?
  sortOrder       Int           @default(0)
  startingAtUSD   Int?
  userPackages    UserPackage[]
  orders          Order[]
}

model User {
  id                      Int                    @id @default(autoincrement())
  email                   String                 @unique
  name                    String?
  hashedPassword          String
  role                    String                 @default("learner")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  timezone                String?
  language                String?                @default("en")
  notificationPreferences Json?
  calendarFeedRevokedAt   DateTime?
  passwordChangedAt       DateTime?
  isDisabled              Boolean                @default(false)
  rateHourlyCents         Int?
  ratePerSessionCents     Int?
  assessmentSubmissions   AssessmentSubmission[]
  audits                  Audit[]                @relation("Audit_actor")
  onboardingForms         OnboardingForm[]
  teachingSessions        Session[]              @relation("SessionTeacher")

  // Legacy 1:1 learner ownership (Session.userId)
  sessions Session[]

  // New: membership rows for group sessions (and future-proof for 1:1 as well)
  sessionParticipants SessionParticipant[]

  sessionFeedbacks SessionFeedback[]
  userPackages     UserPackage[]
  orders           Order[]

  // In-app notifications
  notifications Notification[]

  // Support tickets + messages
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  // ✨ Support ticket assignment (admin can assign tickets to staff)
  assignedSupportTickets SupportTicket[] @relation("AssignedSupportTickets")

  // ✨ Internal notes authored by staff
  supportInternalNotes SupportInternalNote[] @relation("SupportNoteAuthor")

  // Learner feedback on sessions
  learnerFeedbacks LearnerSessionFeedback[] @relation("LearnerFeedbacks")

  // ✨ NEW: User availability for scheduling
  availabilities Availability[]

  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────────
// ✨ NEW: Availability - Users can set their available time slots
// ─────────────────────────────────────────────────────────────────────────────

model Availability {
  id Int @id @default(autoincrement())

  // The user who owns this availability slot
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Day of week (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
  // If null, this is a specific date slot rather than recurring
  dayOfWeek Int?

  // For specific date availability (non-recurring)
  specificDate DateTime?

  // Time range (stored as "HH:MM" in 24h format)
  startTime String // e.g., "09:00"
  endTime   String // e.g., "17:00"

  // Timezone for this availability (user's timezone at creation)
  timezone String?

  // Whether this is a recurring weekly slot or one-time
  isRecurring Boolean @default(true)

  // Status: active, inactive (soft disable without deleting)
  status String @default("active")

  // Optional note/label for the slot
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dayOfWeek])
  @@index([userId, specificDate])
  @@index([status, dayOfWeek])
  @@index([userId, status, isRecurring, dayOfWeek, startTime], map: "Availability_user_status_recur_day_start_idx")
  @@index([userId, status, isRecurring, specificDate, startTime], map: "Availability_user_status_recur_date_start_idx")
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // e.g. booking_confirmed, reminder_24h, payment_receipt
  type String

  title String
  body  String?
  data  Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, readAt, id], map: "Notification_userId_readAt_id_idx")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support: in-app chat-style support, backed by tickets + thread messages
// ✨ ENHANCED with enterprise features
// ─────────────────────────────────────────────────────────────────────────────

enum SupportCategory {
  PAYMENT
  BOOKING
  CLASSROOM_TECH
  ACCOUNT
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ✨ Priority levels for ticket triage
enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id Int @id @default(autoincrement())

  // The user who opened the ticket
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category SupportCategory
  subject  String?
  status   SupportStatus   @default(OPEN)

  // ✨ Priority system (default NORMAL)
  priority SupportPriority @default(NORMAL)

  // ✨ Ticket assignment (which staff member is handling this)
  assignedToId Int?
  assignedTo   User? @relation("AssignedSupportTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Soft resolution timestamps
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  // ✨ Internal notes (staff-only collaboration)
  internalNotes SupportInternalNote[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([category, updatedAt])
  @@index([priority, updatedAt])
  @@index([assignedToId, updatedAt])
  @@index([userId, status, updatedAt], map: "SupportTicket_userId_status_updatedAt_idx")
  @@index([status, priority, updatedAt], map: "SupportTicket_status_priority_updatedAt_idx")
}

model SupportMessage {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Who authored the message
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  // Simple flag for staff replies (we can refine later)
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())

  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model SupportAttachment {
  id Int @id @default(autoincrement())

  messageId Int
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  mimeType String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([messageId])
}

// ✨ Internal notes for staff collaboration
model SupportInternalNote {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Staff member who wrote the note
  authorId Int
  author   User @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model Audit {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  entity    String
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User     @relation("Audit_actor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model Session {
  id      Int       @id @default(autoincrement())
  title   String
  startAt DateTime
  endAt   DateTime?
  notes   String?

  // New: session kind + group capacity
  type     SessionType @default(ONE_ON_ONE)
  capacity Int?

  // Legacy 1:1 learner owner (kept for compatibility + migration)
  // For GROUP sessions, this can be null.
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  teacherId Int?
  teacher   User? @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  // New: participant membership (many learners per session)
  participants SessionParticipant[]

  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  reminder24hSentAt               DateTime?
  reminder6hSentAt                DateTime?
  reminder1hSentAt                DateTime?
  feedbackScore                   Int?
  status                          SessionStatus @default(scheduled)
  joinUrl                         String?
  teacherFeedbackComments         String?
  teacherFeedbackFutureSteps      String?
  teacherFeedbackMessageToLearner String?
  classroomState                  Json?

  feedback SessionFeedback?

  // ─── Classroom Experience Fields ───
  teacherNotes     String?
  resourcesUsed    Json?                    @default("[]")
  resourcesUsedAt  Json?                    @default("{}")
  learnerFeedbacks LearnerSessionFeedback[]

  @@index([userId, startAt])
  @@index([teacherId, startAt])
  @@index([type, startAt])
  @@index([status, startAt], map: "Session_status_startAt_idx")
  @@index([teacherId, status, startAt], map: "Session_teacherId_status_startAt_idx")
  @@index([userId, status, startAt], map: "Session_userId_status_startAt_idx")
}

model SessionParticipant {
  id Int @id @default(autoincrement())

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     String    @default("booked")
  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([userId, status], map: "SessionParticipant_userId_status_idx")
  @@index([sessionId, status], map: "SessionParticipant_sessionId_status_idx")
}

model SessionFeedback {
  id                String   @id @default(cuid())
  sessionId         Int      @unique
  createdAt         DateTime @default(now())
  commentsOnSession String?
  futureSteps       String?
  messageToLearner  String?
  teacherId         Int
  updatedAt         DateTime @updatedAt
  session           Session  @relation(fields: [sessionId], references: [id])
  teacher           User     @relation(fields: [teacherId], references: [id])
}

// ─── Learner Session Feedback (post-session ratings/surveys) ───
model LearnerSessionFeedback {
  id        String @id @default(cuid())
  sessionId Int
  learnerId Int

  // Rating 1-5 stars
  rating Int

  // Optional feedback text fields
  highlights    String?
  improvements  String?
  otherFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner User    @relation("LearnerFeedbacks", fields: [learnerId], references: [id], onDelete: Cascade)

  // Each learner can only submit one feedback per session
  @@unique([sessionId, learnerId])
  @@index([sessionId])
  @@index([learnerId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             String        @id
  amountCents    Int
  currency       String        @default("EGP")
  status         String        @default("pending")
  psp            String        @default("paymob")
  pspOrderId     Int?
  customerEmail  String?
  customerPhone  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  packageId      Int?
  package        Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymobTxnId    Int?
  discountCodeId Int?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  userPackage UserPackage?

  @@index([userId])
  @@index([packageId])
  @@index([status, updatedAt], map: "Order_status_updatedAt_idx")
  @@index([paymobTxnId], map: "Order_paymobTxnId_idx")
  @@index([pspOrderId], map: "Order_pspOrderId_idx")
}

model DiscountCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  percentage Int // 50 = 50% off
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders Order[]
}

model UserPackage {
  id        Int @id @default(autoincrement())
  userId    Int
  packageId Int

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  title             String
  minutesPerSession Int?
  sessionsTotal     Int
  sessionsUsed      Int       @default(0)
  expiresAt         DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  user              User      @relation(fields: [userId], references: [id])
  package           Package   @relation(fields: [packageId], references: [id])

  @@index([userId, status])
  @@index([userId, status, expiresAt], map: "UserPackage_userId_status_expiresAt_idx")
  @@index([userId, status, createdAt], map: "UserPackage_userId_status_createdAt_idx")
}

model OnboardingForm {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  answers   Json
  status    String   @default("submitted")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AssessmentSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  text      String
  wordCount Int
  status    String   @default("submitted")
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum Audience {
  INDIVIDUAL
  CORPORATE
}

enum PriceType {
  PER_SESSION
  BUNDLE
  CUSTOM
}

enum SessionType {
  ONE_ON_ONE
  GROUP
}

enum SessionStatus {
  scheduled
  completed
  canceled
}
