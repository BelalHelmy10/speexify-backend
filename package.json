{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "build": "node scripts/checkSyntax.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node scripts/deployMigrations.js",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
    "start": "node index.js",
    "worker:session-reminders": "node worker/sessionRemindersWorker.js",
    "test:unit": "NODE_ENV=test node --test tests/unit/*.test.js",
    "test:integration": "NODE_ENV=test node --test tests/integration/*.test.js",
    "test:e2e": "NODE_ENV=test RUN_E2E=1 node --test tests/e2e/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "ci:check": "npm run build && npm run test:unit && npm run test:integration && npm run test:e2e",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "send:reminders24h": "node scripts/sendReminders24h.js",
    "send:reminders1h": "node scripts/sendReminders1h.js",
    "backup:create": "node scripts/backupCreate.js",
    "backup:restore": "node scripts/backupRestore.js",
    "backup:drill": "node scripts/backupRecoveryDrill.js",
    "loadtest:10k": "node scripts/loadTestRunner.js 10k",
    "loadtest:100k": "node scripts/loadTestRunner.js 100k",
    "loadtest:1m": "node scripts/loadTestRunner.js 1m",
    "loadtest:smoke": "LOADTEST_SCALE=0.2 LOADTEST_DURATION_SEC=30 LOADTEST_RAMP_SEC=8 LOADTEST_TIMEOUT_MS=3000 node scripts/loadTestRunner.js 10k",
    "security:preflight": "node scripts/securityAuditPreflight.js",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:audit": "npm run security:preflight && npm run security:deps",
    "launch:check": "node scripts/launchReadinessCheck.js",
    "launch:check:strict": "node scripts/launchReadinessCheck.js --strict",
    "privacy:retention:dry": "node scripts/privacyRetentionCleanup.js",
    "privacy:retention:apply": "node scripts/privacyRetentionCleanup.js --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.55.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.3",
    "redis": "^5.10.0",
    "resend": "^6.12.4",
    "ws": "^8.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "napi-postinstall": "^0.3.4",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
